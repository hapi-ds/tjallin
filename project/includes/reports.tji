/* Report Definitions — Acme Web Platform
 *
 * Uses a single textreport frame with navigator for cross-report
 * navigation. All reports are nested inside the frame.
 */

navigator navbar {
  hidereport @none
}

macro TaskTip [
  tooltip istask() -8<-
    '''Start: ''' <-query attribute='start'->
    '''End: ''' <-query attribute='end'->
    ----
    '''Effort: ''' <-query attribute='effort'->
    '''Duration: ''' <-query attribute='duration'->
    '''Cost: ''' <-query attribute='cost'-> ''' EUR'''
  ->8-
]

macro ResourceTip [
  tooltip isresource() -8<-
    '''Resource: ''' <-query attribute='name'->
    ----
    '''Effort: ''' <-query attribute='effort'->
    '''Rate: ''' <-query attribute='rate'-> ''' EUR/h'''
  ->8-
]

textreport frame "Reports" {
  formats html
  balance cost revenue

  header -8<-
    == Acme Web Platform ==
    <[navigator id="navbar"]>
  ->8-
  footer "----"

  taskreport gantt "Gantt Chart" {
    scenarios plan, actual
    headline "Project Gantt Chart"
    columns bsi { title "WBS" },
           name,
           start { title "Start" },
           end { title "End" },
           effort,
           duration,
           cost { title "Cost (EUR)" },
           complete,
           chart { ${TaskTip} scale week width 800 }
    timeformat "%Y-%m-%d"
    loadunit days
    hideresource @all
    caption "Project schedule with dependencies, milestones, and cost per task in EUR."
  }

  resourcereport resources "Resource Usage" {
    headline "Resource Utilization"
    columns no,
           name,
           effort,
           rate,
           weekly { ${ResourceTip} width 800 }
    timeformat "%Y-%m-%d"
    loadunit hours
    hidetask ~(isleaf() & isvalid(plan.effort))
    caption "Weekly resource allocation showing utilization and hourly rates in EUR."
  }

  taskreport tasklist "Task List" {
    headline "Task List"
    columns bsi { title "WBS" },
           name,
           start { title "Start" },
           end { title "End" },
           effort,
           cost { title "Cost (EUR)" },
           revenue { title "Revenue (EUR)" },
           complete,
           status { width 150 }
    timeformat "%Y-%m-%d"
    loadunit days
    hideresource @all
    sorttasks plan.start.up
    caption "Complete task listing with schedule, effort, cost, revenue, and completion."
  }

  accountreport costs "Cost Report" {
    headline "Cost Breakdown (EUR)"
    columns no,
           name,
           cost,
           revenue,
           monthly
    timeformat "%Y-%m-%d"
    caption "Monthly financial breakdown by cost account. All amounts in EUR."
  }

  taskreport journal "Project Journal" {
    headline "Project Journal"
    columns name, journal
    journalmode journal
    journalattributes headline, author, date, summary
    caption "Status updates and decisions recorded throughout the project."
  }
}
