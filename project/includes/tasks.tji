/* Task Definitions — Acme Web Platform
 *
 * Four-phase project demonstrating:
 * - Hierarchical tasks with dependencies and critical path
 * - Resource allocation with cost account assignments
 * - Milestones marking phase boundaries
 * - Scenarios (plan vs actual) for tracking
 * - Journal entries for status reporting
 * - Revenue charges tied to milestones
 */

task acme "Acme Web Platform" {

  /* ===================================================================
   * Phase 1: Planning (2 weeks)
   * =================================================================== */
  task planning "Phase 1: Planning" {

    task requirements "Requirements Gathering" {
      effort 5d
      allocate eve
      allocate alice
      chargeset mgmt
      journalentry 2026-05-26 "Kickoff meeting held" {
        author eve
        summary "Stakeholder kickoff completed. Key requirements identified.
                 Budget confirmed at EUR 180,000."
      }
    }

    task architecture "Architecture Design" {
      effort 5d
      allocate alice
      depends !requirements
      chargeset backend
      journalentry 2026-06-02 "Architecture decision" {
        author alice
        summary "Decided on microservices with PostgreSQL and Redis.
                 API-first approach with OpenAPI spec."
      }
    }

    task wireframes "UX Wireframes" {
      effort 5d
      allocate carol
      chargeset design
      journalentry 2026-06-03 "Wireframes v1 complete" {
        author carol
        summary "First iteration of wireframes delivered.
                 Stakeholder feedback session scheduled for next week."
      }
    }

    task planning_complete "Planning Complete" {
      milestone
      depends !requirements, !architecture, !wireframes
      chargeset milestone1
      charge 30000.0 onend
    }
  }

  /* ===================================================================
   * Phase 2: Development (8 weeks)
   * =================================================================== */
  task development "Phase 2: Development" {
    depends !planning.planning_complete

    task backend_api "Backend API" {

      task schema "Database Schema & Migrations" {
        effort 5d
        allocate alice
        chargeset backend
      }

      task endpoints "REST API Endpoints" {
        effort 15d
        allocate alice
        allocate bob
        depends !schema
        chargeset backend
        journalentry 2026-06-23 "API progress" {
          author alice
          summary "Core CRUD endpoints implemented. Auth endpoints in progress.
                   12 of 18 endpoints complete."
        }
      }

      task auth "Authentication & Authorization" {
        effort 10d
        allocate alice
        depends !schema
        chargeset backend
      }

      task background "Background Jobs & Queues" {
        effort 5d
        allocate bob
        depends !endpoints
        chargeset backend
      }
    }

    task frontend "Frontend UI" {

      task components "Component Library" {
        effort 10d
        allocate bob
        allocate carol
        chargeset frontend
      }

      task layouts "Page Layouts & Navigation" {
        effort 10d
        allocate bob
        depends !components
        chargeset frontend
      }

      task integration "API Integration" {
        effort 10d
        allocate bob
        depends !layouts, acme.development.backend_api.endpoints
        chargeset frontend
      }

      task responsive "Responsive & Accessibility" {
        effort 5d
        allocate carol
        depends !layouts
        chargeset design
      }
    }

    task feature_complete "Feature Complete" {
      milestone
      depends !backend_api, !frontend
      chargeset milestone2
      charge 80000.0 onend
    }
  }

  /* ===================================================================
   * Phase 3: Testing (4 weeks)
   * =================================================================== */
  task testing "Phase 3: Testing" {
    depends !development.feature_complete

    task unit_tests "Unit Test Suite" {
      effort 10d
      allocate dave
      chargeset qa
    }

    task integration_tests "Integration Testing" {
      effort 10d
      allocate dave
      allocate bob
      depends !unit_tests
      chargeset qa
    }

    task performance "Performance & Load Testing" {
      effort 5d
      allocate dave
      depends !unit_tests
      chargeset qa
    }

    task security "Security Audit" {
      effort 5d
      allocate alice
      depends !unit_tests
      chargeset qa
    }

    task uat "User Acceptance Testing" {
      effort 10d
      allocate eve
      allocate carol
      depends !unit_tests
      chargeset qa
    }

    task release_candidate "Release Candidate" {
      milestone
      depends !unit_tests, !integration_tests, !performance, !security, !uat
    }
  }

  /* ===================================================================
   * Phase 4: Deployment (2 weeks)
   * =================================================================== */
  task deployment "Phase 4: Deployment" {
    depends !testing.release_candidate

    task infra "Infrastructure Provisioning" {
      effort 3d
      allocate alice
      chargeset hosting
      charge 2500.0 onstart
    }

    task staging "Staging Deployment & Smoke Tests" {
      effort 3d
      allocate alice
      allocate dave
      depends !infra
      chargeset backend
    }

    task production "Production Deployment" {
      effort 2d
      allocate alice
      depends !staging
      chargeset backend
    }

    task documentation "Operations Documentation" {
      effort 3d
      allocate bob
      depends !staging
      chargeset backend
    }

    task go_live "Go Live" {
      milestone
      depends !infra, !staging, !production, !documentation
      chargeset milestone3
      charge 70000.0 onend
    }
  }
}
