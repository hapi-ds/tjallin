# =============================================================================
# TaskJuggler Docker Compose - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# Required variables are marked with (REQUIRED). The system will refuse to start
# if any required variable is missing or empty.
# =============================================================================

# === Project Configuration ===

# Host path to TaskJuggler project files (bind mount source).
# This directory contains your .tjp and .tji files.
# Default: ./project (the included sample project)
TJ_PROJECT_PATH=./project

# Main project file name (must end in .tjp).
# This file is compiled by the TJ Core Service on each scheduled run.
TJ_PROJECT_FILE=project.tjp

# === Web Service ===

# Host port for the TaskJuggler web interface.
# Access reports at http://localhost:<port> after startup.
# Accepted values: 1-65535
# Default: 8080
TJ_WEB_PORT=8080

# Host port for the admin panel (rebuild, status).
# Access at http://localhost:<port> after startup.
# Accepted values: 1-65535
# Default: 9090
TJ_ADMIN_PORT=9090

# === Mail Configuration ===

# (REQUIRED) Mail domain for receiving timesheet submissions.
# Emails sent to *@<domain> will be processed for timesheet attachments.
TJ_MAIL_DOMAIN=taskjuggler.local

# Sender address used for outgoing notification and reminder emails.
# Default: taskjuggler@<TJ_MAIL_DOMAIN>
TJ_MAIL_SENDER=taskjuggler@taskjuggler.local

# Mail user accounts for IMAP access (optional).
# Comma-separated list of user:password pairs.
# If unset, a single default account is created from TJ_MAIL_SENDER local-part.
# Usernames: 1–64 chars (alphanumeric, dash, dot, underscore).
# Passwords: 1–128 chars (no commas or colons). Max 50 users.
TJ_MAIL_USERS=alice:secret1,bob:secret2

# Host port for IMAP client access (optional).
# Mail clients connect to this port to read messages.
# Accepted values: 1-65535
# Default: 1143
TJ_IMAP_PORT=1143

# === Optional SMTP Relay ===
# Configure these only if you need to forward mail to an external destination.
# When unset, the mail service delivers all messages locally.

# External SMTP relay host for non-local delivery (optional).
#TJ_SMTP_RELAY_HOST=smtp.example.com

# External SMTP relay port (optional, default: 25).
#TJ_SMTP_RELAY_PORT=25

# === Cron Schedules ===
# All schedules use standard 5-field cron expressions:
#   minute hour day-of-month month day-of-week
# See https://crontab.guru/ for help with cron syntax.

# Schedule for project compilation (rebuilding reports).
# Default: every 15 minutes
TJ_CRON_COMPILE=*/15 * * * *

# Schedule for timesheet collection (processing received emails).
# Default: every hour at minute 0
TJ_CRON_TIMESHEETS=0 * * * *

# Schedule for sending timesheet reminder emails.
# Default: weekly on Monday at 09:00
TJ_CRON_REMINDERS=0 9 * * 1

# === System ===

# IANA timezone identifier for all services and cron schedules.
# Examples: UTC, Europe/Stockholm, America/New_York, Asia/Tokyo
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TJ_TIMEZONE=UTC

# Log level for all services.
# Accepted values: DEBUG, INFO, WARNING, ERROR
# If an invalid value is provided, falls back to INFO with a warning.
TJ_LOG_LEVEL=INFO

# Timeout in seconds for cron task execution.
# If a task exceeds this duration, it will be killed and logged as a timeout.
# Must be greater than 0.
TJ_TASK_TIMEOUT=300
