# =============================================================================
# TaskJuggler Docker Compose - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# =============================================================================

# === Project Configuration ===

# Host path to TaskJuggler project files (bind mount source).
# This directory contains your .tjp and .tji files.
# Default: ./project (the included sample project)
TJ_PROJECT_PATH=./project

# Main project file name (must end in .tjp).
TJ_PROJECT_FILE=project.tjp

# === Web Service ===

# Host port for the unified web interface (reports, admin, chat).
# Access at http://localhost:<port> after startup.
# Default: 8080
TJ_WEB_PORT=8080

# === Mail Configuration ===

# Mail domain for receiving timesheet submissions.
# Emails sent to *@<domain> will be processed for timesheet attachments.
TJ_MAIL_DOMAIN=taskjuggler.local

# Sender address for outgoing notification and reminder emails.
# Default: taskjuggler@<TJ_MAIL_DOMAIN>
TJ_MAIL_SENDER=taskjuggler@taskjuggler.local

# Mail user accounts for IMAP access.
# Comma-separated list of user:password pairs.
# These users can connect via IMAP to read reminders and notifications.
# If unset, a single default account is created from TJ_MAIL_SENDER local-part.
TJ_MAIL_USERS=alice:secret1,bob:secret2

# Host port for IMAP client access.
# Mail clients (Thunderbird, Apple Mail, etc.) connect here to read messages.
# Default: 1143
TJ_IMAP_PORT=1143

# === Optional SMTP Relay ===
# Only needed if you want to forward mail to external destinations.
# When unset, all mail is delivered locally within the stack.

#TJ_SMTP_RELAY_HOST=smtp.example.com
#TJ_SMTP_RELAY_PORT=25

# === Cron Schedules ===
# Standard 5-field cron expressions. See https://crontab.guru/

# Project compilation (rebuilding reports). Default: every 15 minutes
TJ_CRON_COMPILE=*/15 * * * *

# Timesheet collection (processing received emails). Default: every hour
TJ_CRON_TIMESHEETS=0 * * * *

# Sending timesheet reminder emails. Default: weekly Monday 09:00
TJ_CRON_REMINDERS=0 9 * * 1

# === System ===

# IANA timezone for all services and cron schedules.
# Examples: UTC, Europe/Stockholm, America/New_York, Asia/Tokyo
TJ_TIMEZONE=UTC

# Log level: DEBUG, INFO, WARNING, ERROR
TJ_LOG_LEVEL=INFO

# Timeout in seconds for cron task execution.
TJ_TASK_TIMEOUT=300

# === LLM Agent Chat ===

# URL of the LM Studio OpenAI-compatible API endpoint.
# Default: http://localhost:1234/v1
TJ_CHAT_LM_STUDIO_URL=http://localhost:1234/v1

# Model name for chat completions (optional).
# If unset, uses the first model available in LM Studio.
#TJ_CHAT_MODEL_NAME=

# Maximum token limit for conversation history.
# Default: 4096
TJ_CHAT_TOKEN_LIMIT=4096

# Default author resource ID for journal entries (optional).
# Used when the user does not specify an author explicitly.
#TJ_CHAT_DEFAULT_AUTHOR=

# Connection timeout to LM Studio (seconds). Default: 10
TJ_CHAT_CONNECTION_TIMEOUT=10

# Response timeout from LM Studio (seconds). Default: 120
TJ_CHAT_RESPONSE_TIMEOUT=120

# Path to bundled TaskJuggler reference documentation.
# Default: /app/tj-docs (inside Docker container)
TJ_CHAT_TJ_DOCS_PATH=/app/tj-docs
